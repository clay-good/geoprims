{
  // Preview-only deploy of the static site to a workers.dev URL, kept out of
  // search engines by preview-worker.mjs until the public release. Production
  // serves the same dist/ from geoprims.com; the problem-report Worker is
  // separate (worker/wrangler.jsonc) and is not part of this deploy.
  "name": "geoprims-preview",
  "main": "preview-worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": { "enabled": false }
}
