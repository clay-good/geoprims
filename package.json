{
  "name": "geoprims",
  "private": true,
  "type": "module",
  "description": "Geospatial and aerospace primitives. Workspace scripts only; no dependencies.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:wasm && npm run build:catalog",
    "build:wasm": "node tools/wasm/build.mjs",
    "build:catalog": "node tools/codegen/catalog.mjs",
    "build:mcp": "node tools/mcp/build-dist.mjs",
    "build:mcpb": "node tools/mcp/build-mcpb.mjs",
    "diff": "node tools/diff/runner.mjs",
    "test": "npm run test:rust && npm run test:js",
    "test:rust": "cargo test --manifest-path core/Cargo.toml",
    "test:js": "node --test 'tools/**/*.test.mjs' 'packages/**/*.test.mjs' 'mcp/**/*.test.mjs' 'worker/**/*.test.mjs'",
    "bench:node": "node tools/perf/bench.mjs",
    "mcp": "node mcp/server.mjs",
    "verify:reproducible": "node tools/wasm/reproducible.mjs",
    "eval:mcp": "node tools/mcp/eval.mjs"
  }
}
