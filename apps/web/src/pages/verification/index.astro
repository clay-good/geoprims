---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { catalog } from '../../lib/catalog.mjs';
---
<Base title="Verification reports · geoprims" description="One verification report per geoprims release, listing every tool's test vectors, sources, largest observed error, and tolerance." canonical="/verification/">
  <PageHeader title="Verification reports" purpose={`One report per release. Each lists every tool's golden test vectors, their sources, the largest observed error against the reference, and the declared tolerance.`} />
  <ul>
    <li><a href={`/verification/${catalog.coreVersion}/`}>Release {catalog.coreVersion}</a> (current)</li>
  </ul>
</Base>
