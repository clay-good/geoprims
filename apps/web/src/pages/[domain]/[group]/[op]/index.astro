---
import Base from '../../../../layouts/Base.astro';
import ToolApp from '../../../../components/ToolApp.svelte';
import PageHeader from '../../../../components/PageHeader.astro';
import { openIssue } from '../../../../lib/known-issues.mjs';
import { breadcrumbs, catalog, clientTool, inputRows, webApplication, canonicalOf, DOMAIN_TITLES, exampleResult, indexable, primaryExample, reviewLine, route, changesFor, CHANGE_KINDS, termsFor, tool as find } from '../../../../lib/catalog.mjs';

export function getStaticPaths() {
  return catalog.tools.map((t) => {
    const [domain, group, op] = t.id.split('.');
    return { params: { domain, group, op }, props: { id: t.id } };
  });
}
const t = find(Astro.props.id);
const ex = primaryExample(t);
const initial = await exampleResult(t);
const issue = openIssue(t.id);
const agentCall = JSON.stringify({ name: 'geoprims_run', arguments: { id: t.id, args: ex.input } }, null, 2);
const jsonld = [webApplication(t), breadcrumbs([['geoprims', '/'], [DOMAIN_TITLES[t.domain] ?? t.domain, route(t.domain)], [t.group.replaceAll('-', ' '), route(`${t.domain}.${t.group}`)], [t.title, route(t.id)]])];
const groupName = t.group.replaceAll('-', ' ');
const inverse = t.related.find((r) => r.reason === 'inverse' && find(r.id));
const related = t.related.filter((r) => find(r.id) && r !== inverse);
// Plain words for why a tool is related (tool.rs `Related`).
const WHY = { inverse: 'Goes the other way', next: 'A common next step', alternative: 'Another way to get this', parent: 'The bigger calculation this is part of' };
const client = clientTool(t);
---
<Base title={`${t.title} · geoprims`} description={t.summary} canonical={canonicalOf(t)} noindex={!indexable(t)} jsonld={jsonld}>
  <PageHeader
    title={t.title}
    crumbs={[[DOMAIN_TITLES[t.domain] ?? t.domain, route(t.domain)], [groupName, route(`${t.domain}.${t.group}`)]]}
    badge={t.stability === 'experimental' ? { text: 'Experimental', title: 'Not yet fully verified' } : undefined}
    purpose={t.summary}
  >
    {inverse && <p class="other-way"><a href={route(inverse.id)}>Go the other way: {find(inverse.id).title} →</a></p>}
  </PageHeader>
  {['aviation', 'drone', 'navigation'].includes(t.domain) && (
    <p class="safety" role="note">
      <span><strong>Planning and education aid. Not for primary navigation.</strong> <a href="/disclaimer/">Full disclaimer</a></span>
    </p>
  )}
  {issue && (
    <p class="card notice known-issue" role="note">
      <a href={`/known-issues/#${issue.id}`}>Known issue: {issue.summary}.</a> Workaround: {issue.workaround}
    </p>
  )}
  <noscript><p class="card notice" role="note">Computing your own values needs JavaScript and WebAssembly. The worked example below was computed when this page was built, and the documentation under "How we got this" applies.</p></noscript>
  <ToolApp client:load tool={client} example={ex.input} initial={initial} />
  <details class="card">
    <summary>How we got this</summary>
    <p><strong>Model:</strong> {t.model}</p>
    <p><strong>Accuracy:</strong> {t.accuracy}</p>
    <p><strong>Worked example:</strong> {ex.title}. Source: {ex.source}.</p>
    <p><strong>Review:</strong> {reviewLine(t.domain, t.id)}</p>
    <p><strong>Status:</strong> version {t.version}, core {catalog.coreVersion}. See this tool in the <a href={`/verification/${catalog.coreVersion}/#${t.id}`}>verification report</a>.</p>
    {changesFor(t.id).length > 0 && (
      <>
        <h3>Changes</h3>
        <ul>{changesFor(t.id).map((e) => <li>{e.date}, {CHANGE_KINDS[e.kind].toLowerCase()}: {e.summary} <a href="/changelog/">Changelog</a></li>)}</ul>
      </>
    )}
    <p><strong>Checked against:</strong> {t.vectorCount} golden test vectors (<a href={`/vectors/${t.id}.jsonl`} download>download the test vectors</a>, each with its source and tolerance). See <a href="/methodology/">how results are checked</a> and <a href="/sources/">every source</a>.</p>
    <h3>Sources</h3>
    <ul>
      {t.references.map((r) => (
        <li><a href={r.url}>{r.title}</a>, {r.issuer}, {r.edition}. {r.locator}.</li>
      ))}
    </ul>
    {t.stability === 'experimental' && (
      <p class="notice">Experimental means this tool has not yet met the stable bar: at least 20 golden vectors, differential tests, and an independent worked example.</p>
    )}
  </details>
  {termsFor(t.id).length > 0 && (
    <details class="card terms">
      <summary>Terms on this page</summary>
      <dl>
        {termsFor(t.id).map((e) => (
          <>
            <dt id={`term-${e.id}`}><abbr title={e.expansion}>{e.term}</abbr>: {e.expansion}</dt>
            <dd>{e.definition}</dd>
          </>
        ))}
      </dl>
    </details>
  )}
  {related.length > 0 && (
    <section>
      <h2>Related tools</h2>
      <ul class="tools">
        {related.map((r) => <li><a href={route(r.id)}>{find(r.id).title}</a> <p>{WHY[r.reason] ?? r.reason}</p></li>)}
      </ul>
    </section>
  )}
  <details class="card dev">
    <summary>For developers and agents</summary>
    <p>Tool id <code>{t.id}</code>, version {t.version}. Run it from the <a href="https://github.com/clay-good/geoprims/tree/main/mcp#readme">local MCP server</a>; the result matches this page byte for byte.</p>
    <table>
      <thead><tr><th scope="col">Input</th><th scope="col">Unit</th><th scope="col">Values</th></tr></thead>
      <tbody>
        {inputRows(t).map((r) => <tr><td><code>{r.name}</code>{r.required ? '' : ' (optional)'}</td><td>{r.unit}</td><td>{r.range}</td></tr>)}
      </tbody>
    </table>
    <p>This call reproduces the worked example:</p>
    <pre class="agent-call">{agentCall}</pre>
  </details>
</Base>
