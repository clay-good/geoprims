---
import Base from '../../layouts/Base.astro';
import { breadcrumbs, catalog, collection, DOMAIN_BLURBS, DOMAIN_TITLES, groups, reviewLine, route } from '../../lib/catalog.mjs';
export function getStaticPaths() {
  return [...new Set(catalog.tools.map((t) => t.domain))].map((domain) => ({ params: { domain } }));
}
const { domain } = Astro.params;
const title = DOMAIN_TITLES[domain] ?? domain;
const byGroup = groups(domain);
const listed = [...byGroup.values()].flat().filter((t) => t.composedOf.length === 0);
const jsonld = [collection(`${title} calculators`, route(domain), listed), breadcrumbs([['geoprims', '/'], [title, route(domain)]])];
---
<Base title={`${title} calculators · geoprims`} description={`Every geoprims ${title.toLowerCase()} tool, with exact, cited math.`} canonical={route(domain)} jsonld={jsonld}>
  <h1>{title}</h1>
  {DOMAIN_BLURBS[domain] && <p class="purpose">{DOMAIN_BLURBS[domain]}</p>}
  <p class="review notice">{reviewLine(domain)}</p>
  {[...byGroup].map(([group, tools]) => {
    const name = group.replaceAll('-', ' ');
    return (
      <section class="group">
        <div class="group-head">
          <h2>{name[0].toUpperCase() + name.slice(1)}</h2>
          <a href={route(`${domain}.${group}`)}>See all</a>
        </div>
        <ul class="tools">
          {tools.filter((t) => t.composedOf.length === 0).map((t) => <li><a href={route(t.id)}>{t.title}</a><p class="clamp3">{t.summary}</p></li>)}
        </ul>
      </section>
    );
  })}
</Base>
