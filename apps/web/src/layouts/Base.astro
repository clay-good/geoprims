---
import '../styles/global.css';
import { catalog } from '../lib/catalog.mjs';
interface Props { title: string; description: string; canonical: string; noindex?: boolean; jsonld?: object[] }
const { title, description, canonical, noindex = false, jsonld = [] } = Astro.props;
// JSON-LD with < escaped so no string can close the script element (search-pages "Structured data allowlist").
const ld = jsonld.map((o) => JSON.stringify(o).replaceAll('<', '\\u003c'));
const canonicalUrl = new URL(canonical, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- The display mode is set before first paint, so no bright frame flashes (visual-theme). -->
    <script is:inline>(()=>{const d=document.documentElement,M=['paper','ink','sunlight','night','high-contrast'],old={hud:'ink',daylight:'paper'};try{const m=(q)=>matchMedia(q).matches;let t=localStorage.getItem('gp-theme');t=old[t]||t;d.dataset.theme=M.includes(t)?t:m('(prefers-contrast: more)')?'high-contrast':m('(prefers-color-scheme: dark)')?'ink':'paper';const v=localStorage.getItem('gp-dim');if(v)d.style.setProperty('--dim',v)}catch{d.dataset.theme='paper'}})();</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="referrer" content="no-referrer" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#f7f6f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1015" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-title" content="geoprims" />
    {ld.map((j) => <script type="application/ld+json" set:html={j} />)}
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/">geoprims</a>
        <nav aria-label="Main">
          <button type="button" class="palette-open" aria-keyshortcuts="/ Control+K Meta+K">Search <kbd aria-hidden="true">/</kbd></button>
          <a href="/units/">Units</a>
          <a href="/agents/">Agents</a>
          <a href="/settings/">Settings</a>
          <a href="https://github.com/clay-good/geoprims">Source</a>
        </nav>
      </div>
    </header>
    <main class="wrap"><slot /></main>
    <footer class="site">
      <div class="wrap">
        <p>
          geoprims tools are planning, engineering, and education aids. They are not certified for navigation and are not legal
          survey determinations. Verify operational values against official sources. <a href="/disclaimer/">Full disclaimer</a>
        </p>
        <p>
          Free, no ads, no tracking. Your inputs never leave your device.
          <a href="https://github.com/clay-good/geoprims/issues/new?template=wrong-answer.yml">Wrong answer?</a>
        </p>
        <form class="display" aria-label="Display">
          <label>Display
            <select name="theme">
              <option value="paper">Paper (light)</option>
              <option value="ink">Ink (dark)</option>
              <option value="sunlight">Sunlight (outdoors)</option>
              <option value="night">Night (dark-adapted)</option>
              <option value="high-contrast">High contrast</option>
            </select>
          </label>
          <label data-for="night">Brightness <input name="dim" type="range" min="0.3" max="1" step="0.05" /></label>
        </form>
        <p class="version">Version <span data-app-version>__GP_APP_VERSION__</span> · core {catalog.coreVersion} · <a href="/changelog/">changelog</a> · <a href={`/verification/${catalog.coreVersion}/`}>verification report</a> · <a href="/methodology/">how results are checked</a> · <a href="/agents/">use with agents</a></p>
      </div>
    </footer>
    <div class="update card" role="status" hidden>
      <p>Update available. Results on screen stay as they are until you reload.</p>
      <button type="button">Reload to update</button>
    </div>
    <script>
      import { wireDisplay } from '../lib/display.js';
      import { wireKeys } from '../lib/keys.js';
      import { registerOffline } from '../lib/pwa.js';
      wireDisplay(document.querySelector('form.display'));
      registerOffline(document.querySelector('.update'));
      // The palette loads on first use: `/` outside text fields, or Ctrl/Cmd+K anywhere.
      const palette = () => import('../lib/palette.js').then((m) => m.openPalette());
      document.querySelector('.palette-open').addEventListener('click', palette);
      wireKeys(palette);
    </script>
  </body>
</html>
