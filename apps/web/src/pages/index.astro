---
import Base from '../layouts/Base.astro';
import { catalog, DOMAIN_BLURBS, DOMAIN_NOUNS, DOMAIN_TITLES, route, sentenceList } from '../lib/catalog.mjs';
const domains = [...new Set(catalog.tools.map((t) => t.domain))];
const ops = catalog.counts.all.operations;
const stable = catalog.counts.stable.operations;
// The description names the domains the catalog actually has, so the claim cannot drift.
const subjects = sentenceList(domains.map((d) => DOMAIN_NOUNS[d] ?? d));
// Example searches under the search field; each opens the palette with the query typed.
const TRY = [
  ['Density altitude', 'density altitude'],
  ['A coordinate', '40.6892, -74.0445'],
  ['Knots to mph', '120 kt to mph'],
  ['Crosswind', 'crosswind'],
  ['Sunrise', 'sunrise'],
];
---
<Base title="geoprims: geospatial and aerospace calculators" description="Exact, cited geodesy, aviation, drone, survey, and unit calculations that run on your device. Free, no ads, no tracking." canonical="/">
  <section class="masthead">
    <h1>The math behind maps, flights, and surveys.</h1>
    <p class="purpose">
      Exact, cited calculators for {subjects}. Every answer shows its formula, its sources, and how far it can be
      trusted. Everything runs on your device: no ads, no accounts, no tracking, and no network after your first visit.
    </p>
    <button type="button" class="hero-search" data-palette>
      <span class="hero-search-text">Search {ops} tools, or paste a coordinate</span>
      <kbd aria-hidden="true">/</kbd>
    </button>
    <p class="chips" aria-label="Examples to try">
      <span class="chips-label">Try</span>
      {TRY.map(([label, query]) => <button type="button" class="chip-button" data-palette={query}>{label}</button>)}
    </p>
  </section>

  <h2 class="sr-only">Browse by topic</h2>
  <ul class="categories">
    {domains.map((d) => (
      <li>
        <a href={route(d)}>{DOMAIN_TITLES[d] ?? d}</a>
        <p class="blurb">{DOMAIN_BLURBS[d] ?? ''}</p>
        <span class="count">{catalog.tools.filter((t) => t.domain === d).length}</span>
      </li>
    ))}
  </ul>
  <p class="all-tools-line"><a href="/tools/">See all {ops} tools on one page</a></p>

  <section class="pinned" hidden aria-labelledby="pinned-title">
    <h2 id="pinned-title">Pinned</h2>
    <ul class="tools"></ul>
  </section>
  <section class="recent" hidden aria-labelledby="recent-title">
    <h2 id="recent-title">Recent</h2>
    <ul class="tools"></ul>
    <p class="notice"><button type="button" class="link">Clear recent tools</button> (kept only in this browser)</p>
  </section>
  <script>
    import { mountLists } from '../lib/lists.js';
    mountLists(document);
  </script>

  <p class="status">Early release: {ops} operations are built so far, and {stable} {stable === 1 ? 'has' : 'have'} passed the full <a href="/methodology/">verification bar</a>. The rest are marked experimental until they do. The same calculators work <a href="/agents/">with AI agents</a>.</p>
</Base>
