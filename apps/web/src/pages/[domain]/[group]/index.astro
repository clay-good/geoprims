---
import Base from '../../../layouts/Base.astro';
import PageHeader from '../../../components/PageHeader.astro';
import ListFilter from '../../../components/ListFilter.astro';
import ToolCards from '../../../components/ToolCards.astro';
import { listDescription } from '../../../lib/head.mjs';
import { breadcrumbs, catalog, groupTitle, collection, DOMAIN_TITLES, hubFor, journeysWith, route } from '../../../lib/catalog.mjs';
export function getStaticPaths() {
  const seen = new Set();
  return catalog.tools
    .filter((t) => !seen.has(`${t.domain}.${t.group}`) && seen.add(`${t.domain}.${t.group}`))
    .map((t) => ({ params: { domain: t.domain, group: t.group } }));
}
const { domain, group } = Astro.params;
const tools = catalog.tools.filter((t) => t.domain === domain && t.group === group);
const name = groupTitle(group);
const domainTitle = DOMAIN_TITLES[domain] ?? domain;
// In running text a group reads in lower case, unless it is an acronym ("IFR", "H3").
const noun = /^[A-Z0-9]+$/.test(name) ? name : name.toLowerCase();
const hub = hubFor(domain, group);
// A hub's own description, never a copy of one of its tools': the summary and
// the tools it lists, or for a units group the units its converter covers.
const lead = tools.find((t) => t.composedOf.length === 0) ?? tools[0];
const description = hub.summary
  ? listDescription(hub.summary, tools.filter((t) => t.composedOf.length === 0).map((t) => t.title))
  : lead.summary.includes(':') ? `Exact ${noun} conversions${lead.summary.slice(lead.summary.indexOf(':'))}` : `Exact ${noun} conversions. ${lead.summary}`;
const guides = journeysWith(tools.map((t) => t.id));
const jsonld = [collection(name, route(`${domain}.${group}`), tools.filter((t) => t.composedOf.length === 0)), breadcrumbs([['geoprims', '/'], [domainTitle, route(domain)], [name, route(`${domain}.${group}`)]])];
---
<Base title={`${name} ${domain === 'units' ? 'converters' : 'calculators'} · ${domainTitle} · geoprims`} og={{ eyebrow: domainTitle, title: name }} description={description} canonical={route(`${domain}.${group}`)} jsonld={jsonld}>
  <PageHeader title={name} crumbs={[[domainTitle, route(domain)]]} purpose={hub.summary || `${tools.length} ${domainTitle.toLowerCase()} ${tools.length === 1 ? 'tool' : 'tools'} for ${noun}.`} />
  {hub.intro && <div class="prose hub-intro"><p>{hub.intro}</p></div>}
  {['aviation', 'drone', 'navigation'].includes(domain) && (
    <p class="safety" role="note">
      <span><strong>Planning and education aid. Not for primary navigation.</strong> <a href="/disclaimer/">Full disclaimer</a></span>
    </p>
  )}
  {tools.length > 8 && <ListFilter total={tools.length} noun={noun} />}
  {hub.tasks.map((task) => (
    <section class="group task" data-group>
      <h2 class="task-want"><span class="want-lead">I want to</span> {task.want}</h2>
      <ToolCards tools={task.tools} />
    </section>
  ))}
  {hub.guide && (
    <section class="card hub-guide" aria-labelledby="guide-title">
      <h2 id="guide-title">{hub.guide.title}</h2>
      <ol>
        {hub.guide.steps.map((s) => <li>{s.text}{s.tool && <> <a href={route(s.tool.id)}>{s.tool.title}</a></>}</li>)}
      </ol>
    </section>
  )}
  {guides.length > 0 && (
    <section class="hub-journeys" aria-labelledby="journeys-title">
      <h2 id="journeys-title">Guides that use these tools</h2>
      <ul>{guides.map((j) => <li><a href={`/journeys/${j.slug}/`}>{j.title}</a>: {j.summary}</li>)}</ul>
    </section>
  )}
</Base>
