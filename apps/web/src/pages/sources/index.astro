---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { catalog, route, tool } from '../../lib/catalog.mjs';
import { join } from 'node:path';
import { readLedger, sourceMap } from '../../../../../tools/trust/ledger.mjs';

const map = [...sourceMap(readLedger(join(process.cwd(), '../..')), catalog).values()].sort((a, b) => a.row.name.localeCompare(b.row.name));
const cited = map.filter((s) => s.tools.size > 0);
const tracked = map.filter((s) => s.tools.size === 0);
---
<Base title="Sources · geoprims" description="Every standard, model, dataset, and regulation geoprims cites, with its current edition, when it was last checked, and the tools that use it." canonical="/sources/">
  <PageHeader title="Sources">
    <p class="purpose">
    Every standard, model, dataset, and regulation behind a geoprims result, from the sources ledger. The build fails if a tool
    cites an edition other than the current one, if a model has expired, or if a source is overdue for a check.
  </p>
  </PageHeader>
  <p>
    "Last checked" is the date someone confirmed the edition at the issuer. Where it says the edition comes from our research
    notes, the issuer's page has not been re-checked yet.
  </p>
  <ul class="issues">
    {cited.map(({ row, tools }) => (
      <li class="card" id={row.id}>
        <h2>{row.name}</h2>
        <p><strong>Issuer:</strong> {row.issuer}. <strong>Edition:</strong> {row.currentEdition}{row.legalStatus === 'proposed' && ' (Proposed)'}.
          {row.validTo && <> <strong>Valid through:</strong> {row.validTo}.</>}</p>
        <p><strong>Last checked:</strong> {row.lastVerified ?? 'not yet'}. {row.verificationNote}</p>
        {row.freeAccessUrl && <p><a href={row.freeAccessUrl}>Issuer page</a></p>}
        <details>
          <summary>{tools.size} {tools.size === 1 ? 'tool cites' : 'tools cite'} it</summary>
          <ul>{[...tools].sort().map((id) => <li><a href={route(id)}>{tool(id)?.title ?? id}</a></li>)}</ul>
        </details>
      </li>
    ))}
  </ul>
  <h2>Tracked, not cited yet</h2>
  <p>Sources the plan depends on, tracked so new editions are noticed before any tool uses them.</p>
  <ul>
    {tracked.map(({ row }) => <li id={row.id}>{row.name} ({row.issuer}), {row.currentEdition}{row.legalStatus === 'proposed' ? ', proposed' : ''}. Last checked: {row.lastVerified ?? 'not yet'}.</li>)}
  </ul>
</Base>
