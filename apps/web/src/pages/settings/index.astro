---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { CANVAS_DEFAULTS, COORD_FORMATS, MOTION, NUMBER_FORMATS, PROFILES } from '../../lib/prefs.js';
---
<Base title="Settings · geoprims" description="Unit profile, number format, display mode, and the data geoprims keeps in this browser." canonical="/settings/" noindex>
  <PageHeader title="Settings" purpose={`Settings apply right away and are saved only in this browser.`} />
  <form class="settings" aria-label="Settings">
    <label>Unit profile
      <select name="profile">{PROFILES.map(([id, label]) => <option value={id}>{label}</option>)}</select>
    </label>
    <p class="notice">Every tool opened afterwards shows its results in these units. A unit you choose in a tool still wins.</p>
    <label>Number format
      <select name="numberFormat">{NUMBER_FORMATS.map(([id, label]) => <option value={id}>{label}</option>)}</select>
    </label>
    <label>Coordinate format
      <select name="coordFormat">{COORD_FORMATS.map(([id, label]) => <option value={id}>{label}</option>)}</select>
    </label>
    <p class="notice">How the map writes the point under your pointer.</p>
    <label>Map view
      <select name="canvas">{CANVAS_DEFAULTS.map(([id, label]) => <option value={id}>{label}</option>)}</select>
    </label>
    <label>Motion
      <select name="motion">{MOTION.map(([id, label]) => <option value={id}>{label}</option>)}</select>
    </label>
    <p class="notice">Reduce motion stops the home page's moving terrain, map camera moves, and every transition, whatever this device is set to.</p>
    <label class="switch">Sounds
      <input type="checkbox" name="audio" />
    </label>
    <label class="audio-volume">Volume
      <input type="range" name="volume" min="0" max="1" step="0.05" />
    </label>
    <p class="notice" data-audio-status>Quiet clicks and tones for results, warnings, and copies. Off unless you turn it on; every sound comes with something you can see.</p>
    <label class="switch">Field mode
      <input type="checkbox" name="fieldMode" />
    </label>
    <p class="notice">Larger buttons, larger answers, and a step button under every number, for gloved hands or a moving vehicle.</p>
    <p class="notice">Light or dark is the control at the top right of every page.</p>
  </form>
  <h2>Data in this browser</h2>
  <p>geoprims keeps your settings, recent and pinned tools, and offline copies of the site on this device only.</p>
  <p class="settings-actions">
    <button type="button" data-action="clear-recent">Clear recent tools</button>
    <button type="button" data-action="erase">Erase all local data</button>
  </p>
  <script>
    import { audioOn, audioState, audioVolume, setAudioOn, setAudioVolume, sound } from '../../lib/sound.js';
    import { canvasDefault, motion, setCanvasDefault, setMotion } from '../../lib/prefs.js';
    import { clearRecents, coordFormat, eraseLocalData, fieldMode, numberFormat, profile, setCoordFormat, setFieldMode, setNumberFormat, setProfile } from '../../lib/prefs.js';
    const form = document.querySelector('form.settings');
    form.profile.value = profile();
    form.numberFormat.value = numberFormat();
    form.profile.addEventListener('change', () => setProfile(form.profile.value));
    form.numberFormat.addEventListener('change', () => setNumberFormat(form.numberFormat.value));
    form.canvas.value = canvasDefault();
    form.canvas.addEventListener('change', () => setCanvasDefault(form.canvas.value));
    form.motion.value = motion();
    form.motion.addEventListener('change', () => setMotion(form.motion.value));
    form.coordFormat.value = coordFormat();
    form.coordFormat.addEventListener('change', () => setCoordFormat(form.coordFormat.value));
    const status = document.querySelector('[data-audio-status]');
    const showAudio = () => {
      form.audio.checked = audioOn();
      form.volume.value = String(audioVolume());
      form.volume.disabled = !audioOn();
      if (audioState() === 'unavailable') status.textContent = 'Audio unavailable in this browser.';
    };
    form.audio.addEventListener('change', () => { setAudioOn(form.audio.checked); if (form.audio.checked) sound('click'); });
    form.volume.addEventListener('change', () => { setAudioVolume(Number(form.volume.value)); sound('click'); });
    addEventListener('gp-audio', showAudio);
    showAudio();
    form.fieldMode.checked = fieldMode();
    form.fieldMode.addEventListener('change', () => setFieldMode(form.fieldMode.checked));
    addEventListener('gp-prefs', () => (form.profile.value = profile()));
    document.querySelector('[data-action=clear-recent]').addEventListener('click', clearRecents);
    document.querySelector('[data-action=erase]').addEventListener('click', eraseLocalData);
  </script>
</Base>
