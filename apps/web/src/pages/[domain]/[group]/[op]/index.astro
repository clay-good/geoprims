---
import Base from '../../../../layouts/Base.astro';
import ToolApp from '../../../../components/ToolApp.svelte';
import PageHeader from '../../../../components/PageHeader.astro';
import { openIssue } from '../../../../lib/known-issues.mjs';
import { defId, markTerms, sourceOf } from '../../../../lib/terms.mjs';
import { freeAccess, ruleStatus } from '../../../../lib/citation.mjs';
import { ledger, ledgerRowFor as rowFor } from '../../../../lib/catalog.mjs';
import { toMathML } from '../../../../lib/mathml.mjs';
import { noticesFor, split } from '../../../../lib/notices.mjs';
import { buildDate } from '../../../../lib/build-date.mjs';
import { title as pageTitle } from '../../../../lib/head.mjs';
import { explainersFor } from '../../../../lib/learn.js';
import { breadcrumbs, catalog, groupTitle, clientTool, webApplication, canonicalOf, DOMAIN_TITLES, exampleResult, indexable, primaryExample, reviewLine, route, changesFor, CHANGE_KINDS, exampleGroups, exampleTrace, lastVerifiedFor, workedVector, sourceRow, sourceRowsFor, termsFor, youEnterYouGet, tool as find } from '../../../../lib/catalog.mjs';

export function getStaticPaths() {
  return catalog.tools.map((t) => {
    const [domain, group, op] = t.id.split('.');
    return { params: { domain, group, op }, props: { id: t.id } };
  });
}
const t = find(Astro.props.id);
const ex = primaryExample(t);
const initial = await exampleResult(t);
const issue = openIssue(t.id);
const { shown: notices, rest: moreNotices } = split(
  noticesFor({ tool: t, issue, changes: changesFor(t.id), sources: sourceRowsFor(t), today: buildDate() }),
);
const worked = youEnterYouGet(t, initial);
const trace = await exampleTrace(t);
const groups = await exampleGroups(t);
const lastVerified = lastVerifiedFor(t);
const golden = workedVector(t);
const jsonld = [webApplication(t), breadcrumbs([['geoprims', '/'], [DOMAIN_TITLES[t.domain] ?? t.domain, route(t.domain)], [groupTitle(t.group), route(`${t.domain}.${t.group}`)], [t.title, route(t.id)]])];
const groupName = groupTitle(t.group);
// The share card shows the worked example's headline answer when it is short
// enough to read at a glance (search-pages, "Open Graph images").
// The first output the result has, as the answer card shows: an optional
// first output may be absent from the worked example.
const lead = Object.keys(t.outputs.properties).find((k) => initial.display?.[k] !== undefined);
const headline = initial.ok && lead !== undefined ? String(initial.display[lead]) : '';
const og = { eyebrow: `${DOMAIN_TITLES[t.domain] ?? t.domain} / ${groupName}`, title: t.title, answer: headline.length <= 24 ? headline : '', caption: initial.ok ? initial.summary : t.summary };
// Neighbors in the group, in catalog order, for the [ and ] shortcuts.
const inGroup = catalog.tools.filter((x) => x.domain === t.domain && x.group === t.group);
const at = inGroup.findIndex((x) => x.id === t.id);
const siblings = { previous: inGroup[at - 1], next: inGroup[at + 1] };
const inverse = t.related.find((r) => r.reason === 'inverse' && find(r.id));
const related = t.related.filter((r) => find(r.id) && r !== inverse);
// Plain words for why a tool is related (tool.rs `Related`).
const WHY = { inverse: 'Goes the other way', next: 'A common next step', alternative: 'Another way to get this', parent: 'The bigger calculation this is part of' };
const client = clientTool(t);
// Explainers that teach this tool's concept (search-pages, "Concept explainers").
const learn = explainersFor(t.id);
// The abbreviations in this tool's purpose line become buttons that open their
// definition (ux/glanceable-results, "Tap to define"). Native popovers: no
// script, so they work with JavaScript off and offline.
const terms = termsFor(t.id);
const purpose = markTerms(t.summary, terms);

---
<Base title={pageTitle(t.title, 'free calculator')} og={og} description={t.summary} canonical={canonicalOf(t)} noindex={!indexable(t)} jsonld={jsonld}>
  <PageHeader
    title={t.title}
    crumbs={[[DOMAIN_TITLES[t.domain] ?? t.domain, route(t.domain)], [groupName, route(`${t.domain}.${t.group}`)]]}
    purpose={purpose.html}
  >
    {inverse && <p class="other-way"><a href={route(inverse.id)}>Go the other way: {find(inverse.id).title} →</a></p>}
  </PageHeader>
  {['aviation', 'drone', 'navigation'].includes(t.domain) && (
    <p class="safety" role="note">
      <span><strong>Planning and education aid. Not for primary navigation.</strong> <a href="/disclaimer/">Full disclaimer</a></span>
    </p>
  )}
  {notices.map((n) => (
    <p class={`card notice ${n.kind}`} role="note">{n.text} <a href={n.href}>{n.linkText}</a></p>
  ))}
  {moreNotices.length > 0 && (
    <details class="card notice more">
      <summary>{moreNotices.length} more {moreNotices.length === 1 ? 'note' : 'notes'}</summary>
      <ul>{moreNotices.map((n) => <li>{n.text} <a href={n.href}>{n.linkText}</a></li>)}</ul>
    </details>
  )}
  <noscript><p class="card notice" role="note">Computing your own values needs JavaScript and WebAssembly. The worked example below was computed when this page was built, and the documentation under "How we got this" applies.</p></noscript>
  <ToolApp client:load tool={client} example={ex.input} initial={initial} />
  <details class="card proof">
    <summary>How we got this<span class="summary-note">Formula, worked example, sources, and proof</span></summary>
    <p><strong>Model:</strong> {t.model}</p>
    {groups.length > 0 && (
      <>
        <h3 class="no-print">Show your work</h3>
        <p class="help no-print">Every coded group of the report, and what it says.</p>
        <dl class="groups no-print">
          {groups.map((g) => (
            <>
              <dt><code>{g.group}</code></dt>
              <dd>{g.meaning}</dd>
            </>
          ))}
        </dl>
      </>
    )}
    {trace.length > 0 && (
      <>
        <h3>Show your work</h3>
        <ol class="trace">
          {trace.map((s) => (
            <li>
              <p class="trace-label">{s.label}</p>
              {toMathML(s.formula)
                ? <p class="trace-formula" set:html={toMathML(s.formula)} />
                : <p class="trace-formula"><code>{s.formula}</code></p>}
              <p class="trace-sub"><code>{s.substituted}</code> = <strong>{s.value}</strong></p>
            </li>
          ))}
        </ol>
        <p class="help no-print">The same steps an agent gets from the MCP server with <code>explain: true</code>.</p>
      </>
    )}
    <p><strong>Accuracy:</strong> {t.accuracy}</p>
    {/* Orientation for a reader, not part of the sheet carried into the field. */}
    {t.whenToUse && <p class="no-print"><strong>When to use this:</strong> {t.whenToUse}</p>}
    {t.limitations && <p class="no-print"><strong>Limitations:</strong> {t.limitations}</p>}
    <p class="no-print"><strong>Worked example:</strong> {ex.title}. Source: {ex.source}.{golden && <> It is golden test vector {golden.id}, and every build checks the tool still gives its answer within its tolerance.</>}</p>
    <div class="worked no-print">
      <div>
        <h3>You enter</h3>
        <dl>{worked.enter.map((r) => <><dt>{r.label}</dt><dd>{r.value}{r.unit ? ` ${r.unit}` : ''}</dd></>)}</dl>
      </div>
      <div>
        <h3>You get</h3>
        <dl>{worked.get.map((r) => <><dt>{r.label}</dt><dd>{r.value}</dd></>)}</dl>
      </div>
    </div>
    <p><strong>Review:</strong> {reviewLine(t.domain, t.id)}</p>
    {lastVerified && <p><strong>Last verified:</strong> {lastVerified}, when a maintainer last confirmed this tool's sources at the issuer. See the <a href="/sources/">sources ledger</a>.</p>}
    <p><strong>Status:</strong> version {t.version}, core {catalog.coreVersion}. See this tool in the <a href={`/verification/${catalog.coreVersion}/#${t.id}`}>verification report</a>.</p>
    {changesFor(t.id).length > 0 && (
      <>
        <h3 class="no-print">Changes</h3>
        <ul class="no-print">{changesFor(t.id).map((e) => <li>{e.date}, {CHANGE_KINDS[e.kind].toLowerCase()}: {e.summary} <a href="/changelog/">Changelog</a></li>)}</ul>
      </>
    )}
    <p><strong>Checked against:</strong> {t.vectorCount} golden test vectors (<a href={`/vectors/${t.id}.jsonl`} download>download the test vectors</a>, each with its source and tolerance). See <a href="/methodology/">how results are checked</a> and <a href="/sources/">every source</a>.</p>
    {(t['x-assumptions'] ?? []).length > 0 && (
      <>
        <h3 class="no-print">Constants this tool assumes</h3>
        <p class="help no-print">Values you do not enter, and where each comes from.</p>
        <dl class="groups assumptions no-print">
          {t['x-assumptions'].map((a) => (
            <>
              <dt>{a.name}</dt>
              <dd><code>{a.value}{a.unit === '1' ? '' : ` ${a.unit}`}</code> — {sourceRow(a.source)?.name ?? a.source}</dd>
            </>
          ))}
        </dl>
      </>
    )}
    <h3>Sources</h3>
    <ul class="sources">
      {t.references.map((r) => {
        const row = rowFor(ledger, r);
        const free = freeAccess(r, row);
        const rule = ruleStatus(row);
        return (
          <li>
            {rule?.kind === 'proposed' && <><span class="rule-label proposed">Proposed</span> </>}
            <a href={r.url}>{r.title}</a>, {r.issuer}, {r.edition}. {r.locator}.
            {free && (free.url
              ? <> <a class="free-access" href={free.url}>{free.label}</a>.</>
              : <> <span class="free-access">{free.label}</span>.</>)}
            {rule && <span class="rule-date"> {rule.url ? <a href={rule.url}>{rule.text}</a> : rule.text}.</span>}
          </li>
        );
      })}
    </ul>
    {termsFor(t.id).length > 0 && (
      <>
        <h3 class="no-print">Terms</h3>
        <dl class="terms no-print">
          {termsFor(t.id).map((e) => (
            <>
              <dt id={`term-${e.id}`}><abbr title={e.expansion}>{e.term}</abbr>: {e.expansion}</dt>
              <dd>{e.definition}{sourceRow(e.source) && <span class="def-source"> Source: {sourceRow(e.source).name}</span>}</dd>
            </>
          ))}
        </dl>
      </>
    )}
    {t.stability === 'experimental' && (
      <p class="notice">Experimental means this tool has not yet met the stable bar: at least 20 golden vectors, differential tests, and an independent worked example.</p>
    )}
  </details>
  {purpose.used.map((e) => (
    <div popover id={defId(e)} class="card def">
      <p class="def-term"><strong>{e.term}</strong> — {e.expansion}</p>
      <p>{e.definition}</p>
      {sourceOf(e, { get: sourceRow }) && <p class="def-source">Source: {sourceOf(e, { get: sourceRow }).name}</p>}
    </div>
  ))}
  {learn.length > 0 && <p class="learn-links">Learn the concept: {learn.map((e, i) => <>{i > 0 && ', '}<a href={e.route}>{e.title}</a></>)}</p>}
  {related.length > 0 && (
    <section class="related" aria-labelledby="related-title">
      <h2 id="related-title">Related tools</h2>
      <ul>
        {related.map((r) => <li><a href={route(r.id)}><span class="related-title">{find(r.id).title}</span><span class="related-why">{WHY[r.reason] ?? r.reason}</span></a></li>)}
      </ul>
    </section>
  )}
  {/* Previous and next tool in the group, for the [ and ] shortcuts. */}
  <div hidden data-sibling data-previous={siblings.previous && route(siblings.previous.id)} data-next={siblings.next && route(siblings.next.id)}></div>
  <script>
    // Printing opens "How we got this", so the sheet carries the formulas,
    // the model, and the sources (web/visual-theme, "Print"); the panel goes
    // back as it was afterwards.
    const proof = document.querySelector('details.proof');
    let wasOpen = null;
    addEventListener('beforeprint', () => {
      if (!proof) return;
      wasOpen = proof.open;
      proof.open = true;
    });
    addEventListener('afterprint', () => {
      if (proof && wasOpen !== null) proof.open = wasOpen;
      wasOpen = null;
    });
  </script>
</Base>
