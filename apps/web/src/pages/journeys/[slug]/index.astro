---
// A learning guide (web/tool-docs, "Learning guides"): one practitioner
// journey, each step a link that opens its tool with the inputs this chain
// computed, the earlier answers already carried in.
import Base from '../../../layouts/Base.astro';
import PageHeader from '../../../components/PageHeader.astro';
import { breadcrumbs, catalog, collection, JOURNEYS, journeyGuides } from '../../../lib/catalog.mjs';
export function getStaticPaths() {
  return JOURNEYS.map((j) => ({ params: { slug: j.slug } }));
}
const guide = (await journeyGuides()).find((j) => j.slug === Astro.params.slug);
const tools = guide.steps.map((s) => catalog.tools.find((t) => t.id === s.tool));
const operational = tools.some((t) => ['aviation', 'drone', 'navigation'].includes(t.domain));
const jsonld = [collection(guide.title, guide.route, tools), breadcrumbs([['geoprims', '/'], [guide.title, guide.route]])];
// A carried input by its title in the tool's form ("line spacing", "GSD").
const title = (s, name) => {
  const t = catalog.tools.find((x) => x.id === s.tool).inputs.properties[name]?.title ?? name.replaceAll('_', ' ');
  return /^[A-Z][a-z]/.test(t) ? t[0].toLowerCase() + t.slice(1) : t;
};
const names = (s) => s.carried.map((c) => `${title(s, c.name)} from step ${c.from + 1}`);
---
<Base title={`${guide.title}: a step-by-step guide · geoprims`} description={guide.summary} canonical={guide.route} jsonld={jsonld}>
  <PageHeader title={guide.title} purpose={guide.summary}>
    <p class="guide-meta">For {guide.audience.toLowerCase()} · {guide.steps.length} steps · each opens with the values filled in</p>
  </PageHeader>
  {operational && (
    <p class="safety" role="note">
      <span><strong>Planning and education aid. Not for primary navigation.</strong> The values here are an example; use your own. <a href="/disclaimer/">Full disclaimer</a></span>
    </p>
  )}
  <ol class="journey">
    {guide.steps.map((s, i) => (
      <li class="card journey-step">
        <p class="step-num">Step {i + 1}</p>
        <h2><a href={s.href}>{s.title}</a></h2>
        <p>{s.why}</p>
        {s.carried.length > 0 && <p class="carried">Carries {names(s).join(', ')}.</p>}
        <p class="expect"><span class="expect-label">You should see</span> {s.result.summary}</p>
        <p><a class="button primary" href={s.href}>Open with these values</a></p>
      </li>
    ))}
  </ol>
</Base>
