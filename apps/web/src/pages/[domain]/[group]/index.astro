---
import Base from '../../../layouts/Base.astro';
import PageHeader from '../../../components/PageHeader.astro';
import ListFilter from '../../../components/ListFilter.astro';
import ToolCards from '../../../components/ToolCards.astro';
import { breadcrumbs, catalog, collection, DOMAIN_TITLES, route } from '../../../lib/catalog.mjs';
export function getStaticPaths() {
  const seen = new Set();
  return catalog.tools
    .filter((t) => !seen.has(`${t.domain}.${t.group}`) && seen.add(`${t.domain}.${t.group}`))
    .map((t) => ({ params: { domain: t.domain, group: t.group } }));
}
const { domain, group } = Astro.params;
const tools = catalog.tools.filter((t) => t.domain === domain && t.group === group);
const name = group.replaceAll('-', ' ');
const domainTitle = DOMAIN_TITLES[domain] ?? domain;
const jsonld = [collection(name, route(`${domain}.${group}`), tools.filter((t) => t.composedOf.length === 0)), breadcrumbs([['geoprims', '/'], [domainTitle, route(domain)], [name, route(`${domain}.${group}`)]])];
---
<Base title={`${name} · ${domainTitle} · geoprims`} description={`geoprims ${name} tools.`} canonical={route(`${domain}.${group}`)} jsonld={jsonld}>
  <PageHeader title={name[0].toUpperCase() + name.slice(1)} crumbs={[[domainTitle, route(domain)]]} purpose={`${tools.length} ${domainTitle.toLowerCase()} ${tools.length === 1 ? 'tool' : 'tools'} for ${name}.`} />
  {tools.length > 8 && <ListFilter total={tools.length} noun={name} />}
  <ToolCards tools={tools} />
</Base>
