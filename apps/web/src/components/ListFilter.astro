---
// The list filter from web/page-template "Lists are findable". Put it above
// the page's `.tools` lists; ToolCards marks each card with its search text.
interface Props {
  total: number;
  noun: string;
}
const { total, noun } = Astro.props;
// "Filter 38 geodesy tools", or "Filter 195 tools" when the list has no one noun.
const placeholder = ['Filter', total, noun, 'tools'].filter((p) => p !== '').join(' ');
---
<div class="filter" role="search">
  <label>
    <span class="sr-only">Filter these tools</span>
    <input type="search" placeholder={placeholder} autocomplete="off" spellcheck="false" />
  </label>
  <p class="filter-count" aria-live="polite"></p>
</div>
<p class="filter-empty card" hidden>
  No tools here match <q></q>. <button type="button" class="quiet" data-palette="">Search all tools</button> or <button type="button" class="link clear">clear the filter</button>.
</p>
<script>
  import { mountFilter } from '../lib/filter.js';
  mountFilter(document);
</script>
