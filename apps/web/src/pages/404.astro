---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { catalog, DOMAIN_TITLES, route, tool } from '../lib/catalog.mjs';
const POPULAR = ['aviation.altimetry.density-altitude', 'aviation.wind.runway-components', 'navigation.geodesic.inverse', 'geodesy.utm.forward', 'units.length.convert'].map(tool).filter(Boolean);
const domains = [...new Set(catalog.tools.map((t) => t.domain))];
---
<Base title="Page not found · geoprims" description="This page does not exist." canonical="/404/" noindex>
  <PageHeader title="We couldn’t find that page" purpose="The link may be old, or the address has a typo. Search for the tool you wanted:" />
  <form class="hero-search" role="search" action="/tools/" method="get">
    <label class="sr-only" for="notfound-q">Search tools</label>
    <input id="notfound-q" type="search" name="q" autocomplete="off" placeholder="Search tools or paste a value" />
    <button type="submit" class="hero-search-go">Search<kbd aria-hidden="true">/</kbd></button>
  </form>
  <h2>Popular</h2>
  <ul class="tools">
    {POPULAR.map((t) => <li><a href={route(t.id)}>{t.title}</a><p class="clamp3">{t.summary}</p></li>)}
  </ul>
  <h2>Browse by topic</h2>
  <nav class="chips" aria-label="Topics">
    {domains.map((d) => <a class="chip-button" href={route(d)}>{DOMAIN_TITLES[d] ?? d}</a>)}
  </nav>
</Base>
