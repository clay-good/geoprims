---
import '../styles/global.css';
import { catalog } from '../lib/catalog.mjs';
import { capTitle, description as capDescription } from '../lib/head.mjs';
interface Props { title: string; description: string; canonical: string; noindex?: boolean; jsonld?: object[] }
const props = Astro.props;
const { canonical, noindex = false, jsonld = [] } = props;
// Every page's head goes through one module, so the caps and the wording
// rules hold whatever a template passes (discovery/search-pages).
const title = capTitle(props.title);
const description = capDescription(props.description);
// JSON-LD with < escaped so no string can close the script element (search-pages "Structured data allowlist").
const ld = jsonld.map((o) => JSON.stringify(o).replaceAll('<', '\\u003c'));
const canonicalUrl = new URL(canonical, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- The display mode is set before first paint, so no bright frame flashes (visual-theme).
         Two modes: a saved choice wins, everything else is paper, whatever the OS prefers.
         Modes that no longer exist (and the older hud/daylight names) map to their replacement. -->
    <script is:inline>(()=>{const d=document.documentElement,old={hud:'ink',night:'ink',daylight:'paper',sunlight:'paper','high-contrast':'paper'};try{let t=localStorage.getItem('gp-theme');t=old[t]||t;d.dataset.theme=t==='ink'?'ink':'paper'}catch{d.dataset.theme='paper'}})();</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="referrer" content="no-referrer" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#f7f6f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1015" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-title" content="geoprims" />
    {ld.map((j) => <script type="application/ld+json" set:html={j} />)}
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/">
          <span class="name">geoprims</span>
          <span class="what">Exact, cited geospatial and aerospace math</span>
        </a>
        <button type="button" class="theme-toggle" data-theme-toggle>
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></svg>
          <span class="label">Dark</span>
        </button>
      </div>
    </header>
    <main class="wrap"><slot /></main>
    <footer class="site">
      <div class="wrap">
        <nav aria-label="Site">
          <button type="button" class="palette-open" aria-keyshortcuts="/ Control+K Meta+K">Search tools <kbd aria-hidden="true">/</kbd></button>
          <a href="/tools/">All tools</a>
          <a href="/units/">Units</a>
          <a href="/agents/">Agents</a>
          <a href="/settings/">Settings</a>
          <a href="https://github.com/clay-good/geoprims">Source</a>
        </nav>
        <p>
          geoprims tools are planning, engineering, and education aids. They are not certified for navigation and are not legal
          survey determinations. Verify operational values against official sources. <a href="/disclaimer/">Full disclaimer</a>
        </p>
        <p>
          Free, no ads, no tracking. Your inputs never leave your device.
          <a href="https://github.com/clay-good/geoprims/issues/new?template=wrong-answer.yml">Wrong answer?</a>
        </p>
        <p class="version">Version <span data-app-version>__GP_APP_VERSION__</span> · core {catalog.coreVersion} · <a href="/changelog/">changelog</a> · <a href={`/verification/${catalog.coreVersion}/`}>verification report</a> · <a href="/methodology/">how results are checked</a> · <a href="/agents/">use with agents</a></p>
      </div>
    </footer>
    <div class="update card" role="status" hidden>
      <p>A new version is ready. Your results stay as they are until you reload.</p>
      <span class="update-actions"><button type="button" class="later">Later</button> <button type="button" class="reload">Reload</button></span>
    </div>
    <script>
      import { wireTheme } from '../lib/display.js';
      import { wireKeys } from '../lib/keys.js';
      import { registerOffline } from '../lib/pwa.js';
      wireTheme(document.querySelector('[data-theme-toggle]'));
      registerOffline(document.querySelector('.update'));
      // The palette loads on first use: `/` outside text fields, or Ctrl/Cmd+K anywhere.
      const palette = (query) => import('../lib/palette.js').then((m) => m.openPalette(query));
      document.querySelector('.palette-open').addEventListener('click', () => palette());
      // Any [data-palette] control opens the palette with its value as the query.
      document.addEventListener('click', (e) => {
        const el = e.target instanceof Element && e.target.closest('[data-palette]');
        if (el) palette(el.getAttribute('data-palette') ?? '');
      });
      wireKeys(palette);
    </script>
  </body>
</html>
