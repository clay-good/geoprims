          "tool": "aviation.wind.runway-components",
          "field": "runway",
          "example": "25"
        },
        {
          "name": "variation",
          "tool": "aviation.wind.runway-components",
          "field": "variation",
          "example": 8
        },
        {
          "name": "max_crosswind",
          "tool": "aviation.wind.runway-components",
          "field": "max_crosswind",
          "example": "15 kt"
        }
      ],
      "steps": [
        {
