          "example": "KDEN 181753Z 30015G25KT 10SM FEW080 SCT200 30/08 A2980 RMK AO2 SLP052 T03000083"
        },
        {
          "name": "elevation",
          "tool": "aviation.altimetry.pressure-altitude",
          "field": "elevation",
          "example": "5434 ft"
        },
        {
