---
import '../styles/global.css';
import { capTitle, description as capDescription } from '../lib/head.mjs';
import { buildHashOf, catalog } from '../lib/catalog.mjs';
import { icon } from '../lib/icons.mjs';
interface Props { title: string; description: string; canonical: string; noindex?: boolean; jsonld?: object[]; og?: { eyebrow?: string; title?: string; answer?: string; caption?: string } }
const props = Astro.props;
const { canonical, noindex = false, jsonld = [], og = {} } = props;
// Every page's head goes through one module, so the caps and the wording
// rules hold whatever a template passes (discovery/search-pages).
const title = capTitle(props.title);
const description = capDescription(props.description);
// JSON-LD with < escaped so no string can close the script element (search-pages "Structured data allowlist").
const ld = jsonld.map((o) => JSON.stringify(o).replaceAll('<', '\\u003c'));
const canonicalUrl = new URL(canonical, Astro.site).href;
// Every page gets a share card rendered after the build by scripts/og.mjs
// (search-pages, "Open Graph images"). The data-og-* words are for that
// script, which strips them from what ships.
const canonicalPath = new URL(canonicalUrl).pathname;
const ogImage = new URL(`/og${canonicalPath === '/' ? '/home' : canonicalPath.replace(/\/$/, '')}.jpg`, Astro.site).href;
const ogTitle = og.title ?? title.replace(/ · geoprims$/, '');
const ogAlt = [ogTitle, og.answer].filter(Boolean).join(': ');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- The display mode is set before first paint, so no bright frame flashes (visual-theme).
         Two modes: a saved choice wins, everything else is paper, whatever the OS prefers.
         Modes that no longer exist (and the older hud/daylight names) map to their replacement. -->
    <script is:inline>(()=>{const d=document.documentElement,old={hud:'ink',night:'ink',daylight:'paper',sunlight:'paper','high-contrast':'paper'};try{let t=localStorage.getItem('gp-theme');t=old[t]||t;d.dataset.theme=t==='ink'?'ink':'paper';if(localStorage.getItem('gp-field-mode')==='true')d.dataset.field='on';if(localStorage.getItem('gp-motion')==='"reduce"')d.dataset.motion='reduce'}catch{d.dataset.theme='paper'}})();</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="geoprims" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} data-og-eyebrow={og.eyebrow} data-og-title={og.title} data-og-answer={og.answer} data-og-caption={og.caption} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="referrer" content="no-referrer" />
    <link rel="preload" href="/fonts/Geist-Variable-subset.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/GeistMono-Variable-subset.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#f3f4f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0f14" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-title" content="geoprims" />
    {ld.map((j) => <script type="application/ld+json" set:html={j} />)}
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/">
          <span class="mark" set:html={icon('reticle', { size: 26 })} />
          <span class="brand-text">
            <span class="name">geoprims</span>
            <span class="what">Field-grade geospatial math</span>
          </span>
        </a>
        <div class="header-tools">
        <button type="button" class="header-search" data-palette aria-keyshortcuts="/ Control+K Meta+K">
          <span set:html={icon('search', { size: 18 })} />
          <span class="label">Search tools</span>
          <kbd aria-hidden="true">/</kbd>
        </button>
        <button type="button" class="audio-toggle" data-audio-toggle hidden aria-pressed="false" aria-label="Mute sounds">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5z" /><path class="waves" d="M15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14" /></svg>
          <span class="label">Sound</span>
        </button>
        <button type="button" class="theme-toggle" data-theme-toggle>
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></svg>
          <span class="label">Dark</span>
        </button>
        </div>
      </div>
    </header>
    <main class="wrap"><slot /></main>
    <footer class="site">
      <div class="wrap"><nav aria-label="Site">
        <a href="/tools/">All tools</a>
        <a href="/units/">Units</a>
        <a href="/learn/">Learn</a>
        <a href="/agents/">Agents</a>
        <a href="https://github.com/clay-good/geoprims">Source</a>
        <a href="/privacy/">Privacy</a>
        <a href="/security/">Security</a>
        <a href="/accuracy/">Accuracy</a>
        <a href="/disclaimer/">Disclaimer</a>
        <a href="/licenses/">Licenses</a>
        <button type="button" class="link footer-report" data-report data-core={catalog.coreVersion} data-build={buildHashOf({ domain: 'units' })}>Report a problem</button>
      </nav></div>
    </footer>
    <div class="update card" role="status" hidden>
      <p>A new version is ready. Your results stay as they are until you reload.</p>
      <span class="update-actions"><button type="button" class="later">Later</button> <button type="button" class="reload">Reload</button></span>
    </div>
    <script>
      import { wireTheme } from '../lib/display.js';
      import { wireKeys } from '../lib/keys.js';
      import { registerOffline } from '../lib/pwa.js';
      wireTheme(document.querySelector('[data-theme-toggle]'));
      registerOffline(document.querySelector('.update'), null);
      // The palette loads on first use: `/` outside text fields, or Ctrl/Cmd+K anywhere.
      const palette = (query) => import('../lib/palette.js').then((m) => m.openPalette(query));
      // Any [data-palette] control opens the palette with its value as the query.
      document.addEventListener('click', (e) => {
        const el = e.target instanceof Element && e.target.closest('[data-palette]');
        if (el) palette(el.getAttribute('data-palette') ?? '');
      });
      wireKeys(palette);
      // "Report a problem" on every page (feedback/problem-reports). A tool page
      // takes it as a report on that tool, with its inputs; any other page gets
      // a page report. The dialog loads only on the first click.
      document.querySelector('[data-report]')?.addEventListener('click', async (e) => {
        if (!dispatchEvent(new Event('gp-report', { cancelable: true }))) return;
        const { core, build } = e.currentTarget.dataset;
        const [{ mount, unmount }, { default: ReportDialog }] = await Promise.all([import('svelte'), import('../components/ReportDialog.svelte')]);
        const host = document.body.appendChild(document.createElement('div'));
        const app = mount(ReportDialog, { target: host, props: { site: { coreVersion: core, buildHash: build }, onclose: () => { unmount(app); host.remove(); } } });
      });
      // Audio: a header mute control only while audio is on (web/audio-feedback).
      import { audioMuted, audioOn, setAudioMuted, sound, wireAudio } from '../lib/sound.js';
      wireAudio();
      const mute = document.querySelector('[data-audio-toggle]');
      const showMute = () => {
        mute.hidden = !audioOn();
        mute.setAttribute('aria-pressed', String(audioMuted()));
        mute.setAttribute('aria-label', audioMuted() ? 'Unmute sounds' : 'Mute sounds');
      };
      mute.addEventListener('click', () => setAudioMuted(!audioMuted()));
      addEventListener('gp-audio', showMute);
      showMute();
      document.querySelector('[data-theme-toggle]').addEventListener('click', () => sound('mode'));
    </script>
  </body>
</html>
